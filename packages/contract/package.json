    "docs": "node scripts/gen-docs.ts",
    "fixtures:json": "node scripts/emit-fixtures.ts"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
