{
  "name": "@bc/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Records, states, API routes and fixtures shared by the Vault, the Hub and their tests. Source of truth: spec/data-model.md.",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./fixtures/data.ts"
  },
  "scripts": {
